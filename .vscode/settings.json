{
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"editor.tabSize": 2,
	"editor.insertSpaces": false,
	"editor.rulers": [100],
	"editor.codeActionsOnSave": {
		"quickfix.oxc": "explicit",
		"source.fixAll.ruff": "explicit"
	},

	// —— Language-specific formatters (oxfmt via the oxc extension) ——
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},

	// —— C/C++ ——
	"[c]": {
		"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
	},
	"[cpp]": {
		"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
	},
	"C_Cpp.clang_format_style": "file",

	// —— Rust (apps/rust: rustfmt.toml, rust-toolchain, Clippy) ——
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust"
	},
	"rust-analyzer.check.command": "clippy",

	// —— Python (scripts/python: ruff check, ruff format) ——
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff"
	},
	"ruff.lint.run": "onSave",

	// —— Bash (scripts/bash: ShellCheck, shfmt -i 4) ——
	"[shellscript]": {
		"editor.defaultFormatter": "mkhl.shfmt",
		"editor.tabSize": 4,
		"editor.insertSpaces": true
	},
	"shfmt.arguments": ["-i", "4"],

	// —— Lua (scripts/lua: luacheck, stylua) ——
	"[lua]": {
		"editor.defaultFormatter": "JohnnyMorganz.stylua"
	},

	// —— CSS / Tailwind ——
	"css.lint.unknownAtRules": "ignore",
	"tailwindCSS.includeLanguages": {
		"typescript": "javascript",
		"typescriptreact": "javascript"
	},

	// —— TypeScript ——
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,



	// —— Files ——
	"files.exclude": {
		"**/.next": true,
		"**/node_modules": true,
		"**/dist": true
	},
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"files.eol": "\n",

	// —— Search ——
	"search.exclude": {
		"**/node_modules": true,
		"**/.next": true,
		"**/dist": true,
		"**/build": true
	},
  "tailwindCSS.classAttributes": [
        "class",
        "className",
        "headerClassName",
        "contentContainerClassName",
        "columnWrapperClassName",
        "endFillColorClassName",
        "imageClassName",
        "tintColorClassName",
        "ios_backgroundColorClassName",
        "thumbColorClassName",
        "trackColorOnClassName",
        "trackColorOffClassName",
        "selectionColorClassName",
        "cursorColorClassName",
        "underlineColorAndroidClassName",
        "placeholderTextColorClassName",
        "selectionHandleColorClassName",
        "colorsClassName",
        "progressBackgroundColorClassName",
        "titleColorClassName",
        "underlayColorClassName",
        "colorClassName",
        "drawerBackgroundColorClassName",
        "statusBarBackgroundColorClassName",
        "backdropColorClassName",
        "backgroundColorClassName",
        "ListFooterComponentClassName",
        "ListHeaderComponentClassName"
    ],
    "tailwindCSS.classFunctions": [
        "useResolveClassNames"
    ]
}

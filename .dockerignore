# Keep the build context small. Context is always the monorepo root.
.git
.github
.devcontainer
.cursor
.agents
.vscode
.idea
.turbo
.oxlintcache
**/.next
**/dist
**/coverage
**/target
**/node_modules
**/*.md
!**/*.mdx

.env
.env.*
!.env.example
env.docker.example

# Host-only / unused for Nest + web images. Their package.json files stay: bun install
# --frozen-lockfile needs every workspace manifest the lockfile lists.
apps/mobile/**
!apps/mobile/package.json
apps/docs/**
!apps/docs/package.json
apps/c
scripts
*.log
.DS_Store
Thumbs.db

    "@rn-primitives/hooks": "^1.5.2",
    "@rn-primitives/types": "^1.5.2",
    "@school-os/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~58.0.2",
    "expo-constants": "~58.0.9",
    "expo-dev-client": "~58.0.10",

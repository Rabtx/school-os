{
	"name": "nest-api",
	"version": "0.0.1",
	"private": true,
	"description": "School OS API (NestJS): tenancy, academics, attendance, homework, assessments and auth",
	"license": "MIT OR Apache-2.0",
	"scripts": {
		"build": "nest build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/database/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "nest start --watch",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:e2e": "vitest run --config vitest.e2e.config.mts",
		"test:integration": "vitest run --config vitest.integration.config.mts",
		"db:seed": "bun src/database/seed/seed.ts",
		"db:seed-demo-logins": "bun src/database/seed/seed-demo-logins.ts"
	},
	"dependencies": {
		"@nestjs/common": "^12.3.2",
		"@nestjs/core": "^12.3.2",
		"@nestjs/platform-express": "^12.3.2",
		"@nestjs/swagger": "^12.1.0",
		"@nestjs/throttler": "^6.7.1",
		"@simplewebauthn/server": "^14.0.3",
		"bcryptjs": "^3.0.3",
		"cookie-parser": "^1.4.7",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"google-auth-library": "^11.3.3",
		"helmet": "^8.3.0",
		"jose": "^6.2.15",
		"multer": "^2.5.0",
		"otplib": "^13.6.0",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"razorpay": "^2.9.8",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"stripe": "^23.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.11",
		"@nestjs/schematics": "^12.0.12",
		"@nestjs/testing": "^12.3.2",
		"@types/bcryptjs": "^3.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.1.0",
		"drizzle-kit": "^0.31.11",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.1",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	}
}
